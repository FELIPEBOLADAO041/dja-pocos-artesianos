# DJA Manutenções — configuração de servidor (Hostinger / Apache)

# ----------------------------------------------------------------------
# HTTPS e domínio único
# ATENÇÃO: só ative estas 3 regras DEPOIS que o SSL estiver emitido no hPanel.
# Se ligar antes, o site entra em loop de redirecionamento.
# Para ativar, apague o "#" das linhas RewriteCond/RewriteRule abaixo.
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # força HTTPS
  # RewriteCond %{HTTPS} off
  # RewriteRule ^(.*)$ https://djamanutencoes.com/$1 [R=301,L]

  # www -> sem www (evita conteúdo duplicado no Google)
  # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  # RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# ----------------------------------------------------------------------
# Compressão
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ----------------------------------------------------------------------
# Cache do navegador
# HTML fica curto porque é o arquivo que muda quando você edita o site.
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html                "access plus 1 hour"
  ExpiresByType text/css                 "access plus 1 year"
  ExpiresByType application/javascript   "access plus 1 year"
  ExpiresByType image/jpeg               "access plus 1 year"
  ExpiresByType image/png                "access plus 1 year"
  ExpiresByType image/svg+xml            "access plus 1 year"
  ExpiresByType image/x-icon             "access plus 1 year"
  ExpiresByType video/mp4                "access plus 1 year"
</IfModule>

# ----------------------------------------------------------------------
# Segurança básica
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# não listar o conteúdo das pastas
Options -Indexes

ErrorDocument 404 /index.html
